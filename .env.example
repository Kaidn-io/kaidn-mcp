# Your Kaidn API key, from https://kaidn.io
# Read from the environment only — never passed as a tool argument.
KAIDN_API_KEY=

# Optional: override the API base URL (defaults to https://api.kaidn.io)
# KAIDN_API_URL=

# Optional: allow the mutating tools (add_to_list, label_outcome).
# Equivalent to passing --allow-writes.
# KAIDN_MCP_ALLOW_WRITES=1

# Optional: ceiling on quota-consuming calls per process (default 100).
# KAIDN_MCP_MAX_QUOTA_CALLS=100
